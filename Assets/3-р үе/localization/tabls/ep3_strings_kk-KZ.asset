  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 11014176768
    m_Localized: "\u0421\u044B\u043D\u044B\u043F\u0442\u0430\u0493\u044B \u0436\u0430\u0493\u044B\u043C\u0434\u044B
      \u049B\u0430\u0440\u044B\u043C-\u049B\u0430\u0442\u044B\u043D\u0430\u0441 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430\u0441\u044B\u043D
      \u043A\u04E9\u0440\u0441\u0435\u0442\u0435\u0442\u0456\u043D 5 \u0441\u04E9\u0437
      \u0441\u04E9\u0439\u043B\u0435\u043C \u0436\u04D9\u043D\u0435 3 \u0441\u0443\u0440\u0435\u0442\u0442\u0456
      \u0442\u0430\u043F. \u041A\u0435\u0437 \u043A\u0435\u043B\u0433\u0435\u043D
      \u0436\u0435\u0440\u0434\u0435 \u0431\u043E\u043B\u0443\u044B \u043C\u04AF\u043C\u043A\u0456\u043D,
      \u043C\u04B1\u049B\u0438\u044F\u0442 \u049B\u0430\u0440\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 636183576576
    m_Localized: "\u0411\u0456\u0437 \u049B\u0430\u0436\u0435\u0442\u0441\u0456\u0437
      \u0436\u0430\u0493\u0434\u0430\u0439\u0434\u0430 \u0431\u0456\u0440\u0435\u0443\u0434\u0456\u04A3
      \u0441\u0443\u0440\u0435\u0442\u0456\u043D \u0442\u04AF\u0441\u0456\u0440\u043C\u0435\u0439\u043C\u0456\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 1084646948864
    m_Localized: "\u0411\u0456\u0437 \u0434\u04E9\u0440\u0435\u043A\u0456 \u0441\u04E9\u0437
      \u049B\u043E\u043B\u0434\u0430\u043D\u0431\u0430\u0439\u043C\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 1425547395072
    m_Localized: "\u0411\u0456\u0437 \u0431\u0430\u0441\u049B\u0430\u043B\u0430\u0440\u0434\u044B
      \u049B\u043E\u0440\u043B\u0430\u0439\u0442\u044B\u043D \u0441\u04E9\u0437 \u0430\u0439\u0442\u043F\u0430\u0439\u043C\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 1782960816128
    m_Localized: "\u041C\u0435\u043D \u0430\u0448\u0443\u043B\u044B, \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u0442\u0456
      \u043C\u0456\u043D\u0435\u0437 \u043A\u04E9\u0440\u0441\u0435\u0442\u043F\u0435\u0439\u043C\u0456\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1891211608064
    m_Localized: "\u0411\u0456\u0437 \u0441\u044B\u043D\u044B\u043F\u0442\u0430 \u0431\u0456\u0440-\u0431\u0456\u0440\u0456\u043C\u0456\u0437\u0434\u0456
      \u043A\u0435\u043B\u0435\u043C\u0435\u0436\u0434\u0435\u043C\u0435\u0439\u043C\u0456\u0437. "
    m_Metadata:
      m_Items: []
  - m_Id: 1981137485824
    m_Localized: "\u041C\u0435\u043D \u0431\u0430\u0441\u049B\u0430\u043B\u0430\u0440\u043C\u0435\u043D
      \u049B\u04B1\u0440\u043C\u0435\u0442\u043F\u0435\u043D \u0441\u04E9\u0439\u043B\u0435\u0441\u0435\u043C\u0456\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2185559474176
    m_Localized: "\u0411\u0456\u0437 \u0431\u0430\u0441\u049B\u0430\u043B\u0430\u0440\u0434\u044B\u04A3
      \u0437\u0430\u0442\u0442\u0430\u0440\u044B\u043D\u0430 \u0440\u04B1\u049B\u0441\u0430\u0442\u0441\u044B\u0437
      \u0442\u0438\u043C\u0435\u0443\u0433\u0435 \u04D9\u0440\u049B\u0430\u0448\u0430\u043D
      \u049B\u0430\u0440\u0441\u044B\u043C\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2304858062848
    m_Localized: "\u0411\u0456\u0440-\u0431\u0456\u0440\u0456\u043C\u0456\u0437\u0433\u0435
      \u049B\u04B1\u0440\u043C\u0435\u0442\u043F\u0435\u043D \u049B\u0430\u0440\u0430\u0443\u0493\u0430
      \u0448\u0430\u049B\u044B\u0440\u0430\u043C\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2467320233984
    m_Localized: "\u0421\u0442\u0438\u043A\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2610421497856
    m_Localized: "\u041A\u0456\u043B\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2721365032960
    m_Localized: "\u0421\u0443\u0440\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2817653669888
    m_Localized: "\u0424\u0443\u0442\u0431\u043E\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2977196605440
    m_Localized: "\u041A\u0456\u0442\u0430\u043F\u0442\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 3108977442816
    m_Localized: "\u0422\u04E9\u0441\u0431\u0435\u043B\u0433\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 3306805985280
    m_Localized: "\u0415\u043C\u0442\u0438\u0445\u0430\u043D \u049B\u0430\u0493\u0430\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3497437102080
    m_Localized: "\u0416\u0430\u0437\u0431\u0430 \u049B\u0430\u0493\u0430\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6117639782400
    m_Localized: "\u0417\u0430\u0442\u0442\u0430\u0440\u0434\u044B \u0438\u0435\u043B\u0435\u0440\u0456\u043D\u0435
      \u0441\u04D9\u0439\u043A\u0435\u0441\u0442\u0456\u0440\u0456\u043F \u0431\u0435\u0440\u0456\u04A3\u0434\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 6248560787456
    m_Localized: "\u041C\u0435\u043D \u049B\u0430\u0442\u0430\u0440\u043B\u0430\u0441\u0442\u0430\u0440
      \u0430\u0440\u0430\u0441\u044B\u043D\u0434\u0430\u0493\u044B \u049B\u043E\u0440\u043B\u044B\u049B\u049B\u0430
      (\u0431\u0443\u043B\u043B\u0438\u043D\u0433\u043A\u0435) \u04B1\u0448\u044B\u0440\u0430\u0493\u0430\u043D
      \u0436\u0430\u043D\u043D\u044B\u04A3 \u0434\u0430\u0443\u0441\u044B\u043D \u0442\u044B\u04A3\u0434\u0430\u0439\u043C\u044B\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 6365149855744
    m_Localized: "\u041C\u0435\u043D \u049B\u0430\u0442\u0430\u0440\u043B\u0430\u0441\u0442\u0430\u0440
      \u0430\u0440\u0430\u0441\u044B\u043D\u0434\u0430\u0493\u044B \u049B\u043E\u0440\u043B\u044B\u049B\u0442\u044B
      \u043A\u04E9\u0440\u0441\u0435\u043C, \u043A\u04E9\u0440\u043C\u0435\u0433\u0435\u043D\u0434\u0435\u0439
      \u043A\u0435\u0439\u0456\u043F \u0442\u0430\u043D\u044B\u0442\u044B\u043F \u04E9\u0442\u0456\u043F
      \u043A\u0435\u0442\u043F\u0435\u0439\u043C\u0456\u043D,."
    m_Metadata:
      m_Items: []
  - m_Id: 6423182245888
    m_Localized: "\u041C\u0435\u043D \u049B\u0430\u0442\u0430\u0440\u043B\u0430\u0441\u0442\u0430\u0440
      \u0430\u0440\u0430\u0441\u044B\u043D\u0434\u0430\u0493\u044B \u049B\u043E\u0440\u043B\u044B\u049B
      \u0442\u0443\u0440\u0430\u043B\u044B \u0431\u0456\u043B\u0441\u0435\u043C,
      \u0441\u0435\u043D\u0456\u043C\u0434\u0456 \u0435\u0440\u0435\u0441\u0435\u043A
      \u0430\u0434\u0430\u043C\u0493\u0430 \u043C\u0456\u043D\u0434\u0435\u0442\u0442\u0456
      \u0442\u04AF\u0440\u0434\u0435 \u0430\u0439\u0442\u0430\u043C\u044B\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 6478765162496
    m_Localized: "\u0411\u0456\u0437 \u049B\u04B1\u0440\u0434\u0430\u0441\u0442\u0430\u0440
      \u0430\u0440\u0430\u0441\u044B\u043D\u0434\u0430\u0493\u044B \u049B\u043E\u0440\u043B\u0430\u0443\u0434\u044B
      \u201C\u0422\u044B\u04A3\u0434\u0430\u0439\u043C\u044B\u043D, \u041A\u04E9\u0440\u0435\u043C\u0456\u043D,
      \u0410\u0439\u0442\u0430\u043C\u044B\u043D\u201D \u049B\u0430\u0493\u0438\u0434\u0430\u0441\u044B\u043C\u0435\u043D
      \u0435\u043B\u0435\u043C\u0435\u0439 \u04E9\u0442\u0456\u043F \u043A\u0435\u0442\u043F\u0435\u0439\u043C\u0456\u0437.
      \u049A\u043E\u043B\u044B\u043C\u044B\u0437\u0434\u0430\u043D \u043A\u0435\u043B\u0433\u0435\u043D\u0448\u0435
      \u0430\u0440\u0430\u043B\u0430\u0441\u044B\u043F, \u0431\u0456\u0440\u0433\u0435
      \u0442\u043E\u049B\u0442\u0430\u0442\u0430 \u0430\u043B\u0430\u043C\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6586588135424
    m_Localized: "\u0421\u04B1\u0440\u0430\u049B\u0442\u0430\u0440\u0493\u0430 \u0434\u04B1\u0440\u044B\u0441
      \u0436\u0430\u0443\u0430\u043F \u0431\u0435\u0440\u0456\u043F, \u201C\u043A\u04E9\u043C\u0435\u043A
      \u043A\u04E9\u043F\u0456\u0440\u0456\u043D\u201D \u0440\u0435\u0442\u0442\u0435\u043F,
      \u049B\u044B\u0437\u0493\u0430 \u043A\u04E9\u043C\u0435\u043A\u0442\u0435\u0441\u0435\u0439\u0456\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 6664744796160
    m_Localized: "\u0414\u043E\u0441\u044B\u04A3 \u0436\u044B\u043B\u0430\u043F \u043E\u0442\u044B\u0440,
      \u0441\u0435\u043D \u043D\u0435 \u0456\u0441\u0442\u0435\u0439\u0441\u0456\u04A3?"
    m_Metadata:
      m_Items: []
  - m_Id: 6783376490496
    m_Localized: "\u0415\u0448\u0442\u0435\u04A3\u0435 \u0435\u0442\u043F\u0435\u0441,
      \u0441\u0430\u0431\u044B\u0440 \u0441\u0430\u049B\u0442\u0430\xBB \u0434\u0435\u043F
      \u043A\u0435\u0442\u0435 \u0431\u0435\u0440\u0435\u043C\u0456\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 6891564367872
    m_Localized: "\u041D\u0435\u0433\u0435 \u0436\u044B\u043B\u0430\u0493\u0430\u043D\u044B\u043D\u044B\u04A3
      \u0441\u0435\u0431\u0435\u0431\u0456\u043D \u0441\u04B1\u0440\u0430\u0439\u043C\u044B\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 6994765217792
    m_Localized: "\u0414\u043E\u0441\u044B\u04A3\u043D\u044B\u04A3 \u0437\u0430\u0442\u0442\u0430\u0440\u044B\u043D
      \u0431\u0456\u0440\u0435\u0443 \u04D9\u0434\u0435\u0439\u0456 \u0436\u044B\u0440\u0442\u044B\u043F,
      \u0441\u044B\u043D\u044B\u043F\u0442\u044B\u04A3 \u0431\u04B1\u0440\u044B\u0448\u044B\u043D\u0430
      \u043B\u0430\u049B\u0442\u044B\u0440\u044B\u043F \u0436\u0456\u0431\u0435\u0440\u0433\u0435\u043D\u0456\u043D
      \u0435\u0441\u0442\u0456\u0441\u0435\u04A3\xBB, \u043D\u0435 \u0456\u0441\u0442\u0435\u0439\u0441\u0456\u04A3?"
    m_Metadata:
      m_Items: []
  - m_Id: 7082099015680
    m_Localized: "\u0410. \u041C\u04B1\u0493\u0430\u043B\u0456\u043C\u0433\u0435
      \u0430\u0439\u0442\u0443\u0493\u0430 \u043A\u0435\u04A3\u0435\u0441 \u0431\u0435\u0440\u0435\u043C\u0456\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 7148297715712
    m_Localized: "\u0411. \xAB\u041A\u0435\u043B\u0435\u0441\u0456 \u0436\u043E\u043B\u044B
      \u043E\u043B\u0430\u0439 \u0456\u0441\u0442\u0435\u043C\u0435\u0441, \u0431\u04B1\u043B
      \u0436\u043E\u043B\u044B \u043C\u04D9\u043D \u0431\u0435\u0440\u043C\u0435\u0439-\u0430\u049B
      \u049B\u043E\u0439\xBB \u0434\u0435\u043F \u043A\u0435\u04A3\u0435\u0441 \u0431\u0435\u0440\u0435\u043C\u0456\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 7227104493568
    m_Localized: "\u0414\u043E\u0441\u044B\u04A3\u043D\u044B\u04A3 \u049B\u043E\u043B\u044B
      \u043A\u04E9\u0433\u0435\u0440\u0456\u043F \u049B\u0430\u043B\u0493\u0430\u043D
      \u0436\u04D9\u043D\u0435 \u043E\u043D\u044B \u0441\u0435\u043D\u0435\u043D
      \u04D9\u0434\u0435\u0439\u0456 \u0436\u0430\u0441\u044B\u0440\u044B\u043F \u0442\u04B1\u0440.
      \u0411\u04B1\u043B \u0436\u0430\u0493\u0434\u0430\u0439\u0434\u0430 \u043D\u0435
      \u0456\u0441\u0442\u0435\u0439\u0441\u0456\u04A3?"
    m_Metadata:
      m_Items: []
  - m_Id: 7286416146432
    m_Localized: "\u0410. \u0416\u0430\u0441\u044B\u0440\u044B\u043F \u0442\u04B1\u0440\u0493\u0430\u043D
      \u0441\u043E\u04A3, \u043C\u0435\u043D\u0456\u04A3 \u0448\u0430\u0440\u0443\u0430\u043C
      \u049B\u0430\u043D\u0448\u0430 \u0434\u0435\u043F \u043A\u0435\u0442\u0456\u043F
      \u049B\u0430\u043B\u0430\u043C\u044B\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 7363742334976
    m_Localized: "\u0411. \u041D\u0435\u0433\u0435 \u043A\u04E9\u0433\u0435\u0440\u0433\u0435\u043D\u0456\u043D
      \u0430\u043D\u044B\u049B\u0442\u0430\u043F \u0441\u04B1\u0440\u0430\u0439\u043C\u044B\u043D
      \u0436\u04D9\u043D\u0435 \u043C\u04B1\u0493\u0430\u043B\u0456\u043C\u043C\u0435\u043D
      \u0430\u049B\u044B\u043B\u0434\u0430\u0441\u0430\u043C\u044B\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 7940559798272
    m_Localized: "\u041A\u04E9\u043C\u0435\u043A \u043A\u04E9\u043F\u0456\u0440\u0456\u043D
      \u0436\u04E9\u043D\u0434\u0435\u043F \u0431\u0435\u0440\u0433\u0435\u043D\u0434\u0435\u0440\u0456\u04A3\u0433\u0435
      \u0440\u0430\u049B\u043C\u0435\u0442."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
