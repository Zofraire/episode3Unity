  m_TableData:
  - m_Id: 10972233728
    m_Localized: "\u042D\u043D\u044D \u0437\u0443\u0440\u0430\u0433 \u044F\u043C\u0430\u0440
      \u0442\u04E9\u0440\u043B\u0438\u0439\u043D \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u044D\u043B\u0442\u0438\u0439\u0433
      \u0438\u043B\u044D\u0440\u0445\u0438\u0439\u043B\u0436 \u0431\u0430\u0439\u043D\u0430
      \u0432\u044D?"
    m_Metadata:
      m_Items: []
  - m_Id: 781189054464
    m_Localized: "\u0411\u0438\u0435 \u043C\u0430\u0445\u0431\u043E\u0434\u044B\u043D
      \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u044D\u043B\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1079328571392
    m_Localized: "\u04AE\u0433\u0438\u0439\u043D \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u044D\u043B\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1243585904640
    m_Localized: "\u041D\u0438\u0439\u0433\u043C\u0438\u0439\u043D (\u0445\u0430\u0440\u0438\u043B\u0446\u0430\u0430\u043D\u044B)
      \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u044D\u043B\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1392567582720
    m_Localized: "\u0426\u0430\u0445\u0438\u043C \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u044D\u043B\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1486352220160
    m_Localized: "\u0425\u044D\u0440\u0432\u044D\u044D \u0447\u0438 \u0430\u043D\u0433\u0438\u0434\u0430\u0430
      \u0438\u0439\u043C \u044F\u0432\u0434\u0430\u043B \u0445\u0430\u0440\u0432\u0430\u043B
      \u0431\u0443\u0441\u0434\u0430\u0434\u0430\u0430 \u044E\u0443 \u0433\u044D\u0436
      \u0445\u044D\u043B\u0436 \u0443\u0440\u0438\u0430\u043B\u0430\u0445 \u0432\u044D?"
    m_Metadata:
      m_Items: []
  - m_Id: 1819224768512
    m_Localized: "\u0422\u04AF\u04AF\u043D\u0438\u0439\u0433 \u0431\u0438\u0442\u0433\u0438\u0439
      \u0441\u0430\u043D\u0434\u0430\u043B\u0434 \u0441\u0443\u0443\u043B\u0433\u0430\u0430\u0440\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1676580683776
    m_Localized: "\u0411\u04AF\u0433\u0434 \u043D\u044D\u0433 \u0430\u043D\u0433\u0438\u0439\u043D\u0445\u0430\u043D
      \u0431\u0430\u0439\u0436 \u043D\u044D\u0433\u043D\u044D\u044D \u0438\u043D\u0433\u044D\u0436
      \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u044D\u0445\u044D\u044D \u0431\u043E\u043B\u044C\u0451
      \u043E\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1902741749760
    m_Localized: "\u041D\u0430\u0434\u0430\u0430\u0441 \u043B \u0445\u043E\u043B\u0443\u0443\u0440
      \u0431\u0430\u0439\u0432\u0430\u043B \u0431\u0443\u0441\u0430\u0434 \u043D\u044C
      \u0445\u0430\u043C\u0430\u0430 \u0430\u043B\u0433\u0430 \u04E9\u04E9"
    m_Metadata:
      m_Items: []
  - m_Id: 1997507854336
    m_Localized: "\u0417\u04AF\u0433\u044D\u044D\u0440 \u0434\u044D\u044D, \u0442\u043E\u043E\u0445
      \u0445\u044D\u0440\u044D\u0433\u0433\u04AF\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2118538690560
    m_Localized: "\u0411\u0438\u0440 \u044D\u043C\u0435\u0441 \u043A\u044B\u043C
      \u0431\u0438\u0440\u044D\u044D\u0437\u0438 \u0446\u0430\u0445\u0438\u043C \u0445\u04AF\u0440\u044D\u044D\u043B\u0435\u043B\u0433\u0435
      \u0441\u0435\u043D\u0438 \u0430\u0437\u044B \u0430\u0434\u0430\u0436\u044B\u04A3\u043D\u044B
      \u0431\u0430\u043A\u0442\u0430\u043F \u0442\u0443\u0440\u0441\u0430, \u0441\u0435\u043D
      \u0447\u04AF\u043D\u04AF \u043A\u044B\u043B\u044B\u0440 \u0443\u0436\u0443\u0440\u043B\u0443\u0433
      \u0441\u0435\u043D?"
    m_Metadata:
      m_Items: []
  - m_Id: 2175082102784
    m_Localized: "\u0421\u043A\u0440\u0438\u043D\u0448\u043E\u0442 \u0445\u0438\u0439\u043D
      \u0442\u043E\u043C \u0445\u04AF\u043D\u0434 (\u044D\u0446\u044D\u0433 \u044D\u0445,
      \u0431\u0430\u0433\u0448\u0438\u0434) \u04AF\u0437\u04AF\u04AF\u043B\u044D\u043D
      \u0430\u0440\u0433\u0430 \u0445\u044D\u043C\u0436\u044D\u044D \u0430\u0432\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2293864792064
    m_Localized: "\u0421\u043A\u0440\u0438\u043D\u0448\u043E\u0442 \u0445\u0438\u0439\u043D
      \u0442\u043E\u043C \u0445\u04AF\u043D\u0434 (\u044D\u0446\u044D\u0433 \u044D\u0445,
      \u0431\u0430\u0433\u0448\u0438\u0434) \u04AF\u0437\u04AF\u04AF\u043B\u044D\u043D
      \u0430\u0440\u0433\u0430 \u0445\u044D\u043C\u0436\u044D\u044D \u0430\u0432\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2405777211392
    m_Localized: "\u0422\u044D\u0440 \u043F\u043E\u0441\u0442 \u0431\u043E\u043B\u043E\u043D
      \u0447\u0430\u0442\u044B\u0433 \u0431\u0443\u0441\u0430\u0434\u0442\u0430\u0439
      \u0445\u0443\u0432\u0430\u0430\u043B\u0446\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2524861890560
    m_Localized: "\u0425\u0430\u0440\u0438\u0443\u0434 \u043D\u044C \u0431\u0430\u0441
      \u0434\u044D\u043C\u0436\u0441\u044D\u043D \u044D\u043C\u043E\u0436\u0438 \u044F\u0432\u0443\u0443\u043B\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2628243095552
    m_Localized: "\u041D\u0430\u0439\u0437\u0443\u0443\u0434\u0430\u0430 \u044D\u0440\u0433\u044D\u043D
      \u0442\u043E\u0439\u0440\u043E\u043D\u0434 \u0447\u0438\u043D\u044C \u0445\u044D\u043D
      \u043D\u044D\u0433\u044D\u043D \u0433\u0430\u043D\u0446\u0430\u0430\u0440 \u0448\u0430\u043D\u0430\u043B\u0436
      \u0445\u044D\u0446\u04AF\u04AF \u0431\u0430\u0439\u0445\u044B\u0433 \u043D\u044C
      \u0445\u0430\u0440\u0436, \u043C\u044D\u0434\u044D\u0440\u0441\u044D\u043D
      \u0431\u043E\u043B \u0434\u0443\u0443\u0433\u04AF\u0439 \u04E9\u043D\u0433\u04E9\u0440\u04E9\u043B\u0433\u04AF\u0439
      \u0442\u0443\u0441\u043B\u0430\u043C\u0436 \u0445\u044D\u0440\u044D\u0433\u0442\u044D\u0439
      \u04AF\u0435\u0434 \u043D\u044C \u0437\u0430\u0430\u0432\u0430\u043B \u0433\u0430\u0440
      \u0441\u0443\u043D\u0433\u0430\u043D \u0442\u0443\u0441\u043B\u0430\u0445\u044B\u0433
      \u0445\u0438\u0447\u044D\u044D\u0433\u044D\u044D\u0440\u044D\u0439. \u0425\u04AF\u04AF\u0445\u044D\u0434
      \u0431\u04AF\u0445\u044D\u043D \u0442\u0430\u0439\u0432\u0430\u043D \u0430\u043C\u0433\u0430\u043B\u0430\u043D
      \u0431\u0430\u0439\u0445 \u043E\u0440\u0447\u043D\u044B\u0433 \u0445\u0430\u043C\u0442\u0434\u0430\u0430
      \u0431\u04AF\u0442\u044D\u044D\u0446\u0433\u044D\u044D\u0435. "
    m_Metadata:
      m_Items: []
  - m_Id: 2736225452032
    m_Localized: "\u0417\u04E9\u0432 \u0431\u0430\u0439\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2874008338432
    m_Localized: "\u0427\u0443\u0440\u0443\u043A\u0442\u0443 \u044D\u043A\u0438 \u043A\u04E9\u0440\u0433\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 7492452941824
    m_Localized: "\u041D\u0430\u0439\u0437\u0443\u0443\u0434\u0430\u0430, \u04AF\u0435
      \u0442\u044D\u043D\u0433\u0438\u0439\u043D \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u044D\u043B\u0442\u0438\u0439\u0433
      \u0445\u0430\u0440\u0441\u0430\u043D \u0434\u0430\u0440\u0443\u0439\u0434\u0430\u0430
      \u0431\u0438\u0434\u043D\u0438\u0439 \u0441\u044D\u0442\u0433\u044D\u043B \u0445\u04E9\u0434\u043B\u04E9\u043B\u04AF\u04AF\u0434
      \u0442\u044D\u0440 \u04AF\u0439\u043B\u0434\u043B\u0438\u0439\u0433 \u0445\u044D\u0440\u0445\u044D\u043D
      \u043C\u044D\u0434\u044D\u0440\u0447 \u0445\u0430\u0440\u0438\u0443 \u04AF\u0439\u043B\u0434\u044D\u043B
      \u04AF\u0437\u04AF\u04AF\u043B\u0436 \u0431\u043E\u043B\u043E\u0445\u044B\u0433
      \u0445\u0430\u0440\u0446\u0433\u0430\u0430\u044F "
    m_Metadata:
      m_Items: []
  - m_Id: 7922851446784
    m_Localized: "\u04E8\u043D\u0433\u04E9\u043D\u0438\u0439 \u0434\u0430\u0440\u0430\u0430\u043B\u043B\u044B\u0433
      \u0441\u0430\u0439\u043D \u0446\u044D\u044D\u0436\u043B\u044D\u044D\u0440\u044D\u0439.
      \u0422\u044D\u0433\u044D\u044D\u0434 \u0434\u0430\u0440\u0430\u0430\u043B\u043B\u044B\u043D
      \u0434\u0430\u0433\u0443\u0443 \u0434\u0430\u0440\u0430\u0430\u0440\u0430\u0439 "
    m_Metadata:
      m_Items: []
  - m_Id: 7988756545536
    m_Localized: "\u0411\u0443\u0441\u0434\u044B\u0433 \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u044D\u0436
      \u0431\u0443\u0439\u0433 \u0445\u0430\u0440\u0430\u0430\u0434 \u0443\u0443\u0440
      \u0445\u04AF\u0440\u0434\u044D\u0433. \u042D\u043D\u044D \u0443\u0443\u0440
      \u0431\u043E\u043B \u0437\u04AF\u0433\u044D\u044D\u0440 \u043D\u044D\u0433
      \u0443\u0446\u0430\u0430\u0440 \u0431\u0438\u0448 \u201C\u0448\u0443\u0434\u0430\u0440\u0433\u0430
      \u0431\u0443\u0441\u201D \u0431\u0430\u0439\u0434\u0430\u043B\u0434 \u0434\u0443\u0440\u0433\u04AF\u0439\u0446\u044D\u0436
      \u0431\u0443\u0439\u043D \u0438\u043B\u0440\u044D\u043B. \u0423\u0443\u0440\u043B\u0430\u0441\u0430\u043D
      \u04AF\u0435\u0434\u044D\u044D \u0447 \u0437\u04E9\u0432 \u0437\u04AF\u0439\u043B
      \u0445\u0438\u0439\u0436, \u0442\u0443\u0441\u043B\u0430\u043C\u0436 \u0434\u0443\u0443\u0434\u0430\u0436
      \u0447\u0430\u0434\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 32333046415360
    m_Localized: "\u0425\u044D\u043D \u043D\u044D\u0433\u043D\u0438\u0439\u0433 \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u04AF\u04AF\u043B\u0436
      \u0431\u0430\u0439\u0445\u044B\u0433 \u0445\u0430\u0440\u0430\u0445 \u04AF\u043D\u044D\u0445\u044D\u044D\u0440
      \u0433\u0443\u043D\u0438\u0433\u0442\u0430\u0439. \u0413\u044D\u0445\u0434\u044D\u044D
      \u044D\u043D\u044D \u0433\u0443\u043D\u0438\u0433 \u0431\u0438\u0434\u044D\u043D\u0434:
      \u201C\u0411\u0438 \u0438\u0439\u043C \u0437\u04AF\u0439\u043B\u0438\u0439\u0433
      \u0437\u04AF\u0433\u044D\u044D\u0440 \u04E9\u043D\u0433\u04E9\u0440\u04E9\u04E9\u043C\u04E9\u04E9\u0440\u0433\u04AF\u0439
      \u0431\u0430\u0439\u043D\u0430\u201D \u0433\u044D\u0436 \u0441\u0430\u043D\u0443\u0443\u043B\u0436
      \u0431\u0443\u0439 \u0434\u043E\u0445\u0438\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 32422259261440
    m_Localized: "\u0425\u044D\u043D \u043D\u044D\u0433\u043D\u0438\u0439\u0433 \u0445\u0430\u043C\u0433\u0430\u0430\u043B\u0430\u0445\u044B\u0433
      \u0445\u04AF\u0441\u0441\u044D\u043D \u0447 \u201C\u0411\u0438 \u04E9\u04E9\u0440\u04E9\u04E9
      \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u04AF\u04AF\u043B\u0436 \u043C\u0430\u0433\u0430\u0434\u0433\u04AF\u0439\u201D
      \u0445\u044D\u043C\u044D\u044D\u043D \u0430\u0439\u0445 \u043C\u044D\u0434\u0440\u044D\u043C\u0436
      \u0442\u04E9\u0440\u0434\u04E9\u0433. \u0413\u044D\u0445\u0434\u044D\u044D
      \u0437\u04E9\u0432 \u0445\u04AF\u043D\u044D\u044D\u0441 /\u0411\u0430\u0433\u0448,
      \u04E9\u04E9\u0440\u0438\u0439\u043D \u0438\u0442\u0433\u044D\u0434\u044D\u0433
      \u0442\u043E\u043C \u0445\u04AF\u043D/-\u0441 \u0442\u0443\u0441\u043B\u0430\u043C\u0436
      \u0445\u04AF\u0441\u044D\u0445 \u043D\u044C \u0430\u0439\u0434\u0441\u044B\u0433
      \u0434\u0430\u0432\u0436 \u0431\u0443\u0439 \u0437\u043E\u0440\u0438\u0433
      \u044E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 32515146317824
    m_Localized: "\u0425\u044D\u043D \u043D\u044D\u0433\u043D\u0438\u0439\u0433 \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u04AF\u04AF\u043B\u0436
      \u0431\u0443\u0439\u0433 \u0445\u0430\u0440\u0430\u0430\u0434 \"\u042F\u0430\u0433\u0430\u0430\u0434
      \u0438\u0439\u043C \u0437\u04AF\u0439\u043B \u0431\u043E\u043B\u0436 \u0431\u0430\u0439\u043D\u0430
      \u0432\u044D \u0433\u044D\u0436 \u0433\u0430\u0439\u0445\u0430\u0436 \u043C\u0430\u0433\u0430\u0434\u0433\u04AF\u0439.
      \u0413\u0430\u0439\u0445\u0430\u0445 \u043C\u044D\u0434\u0440\u044D\u043C\u0436
      \u043D\u044C \u0431\u0438\u0434\u044D\u043D\u0434 \u043E\u0439\u043B\u0433\u043E\u0445,
      \u0430\u0441\u0443\u0443\u0445\", \u044E\u0443 \u0437\u04E9\u0432 \u0431\u043E\u043B\u043E\u0445\u044B\u0433
      \u044D\u0440\u0433\u044D\u0446\u04AF\u04AF\u043B\u044D\u0445 \u0431\u043E\u043B\u043E\u043C\u0436\u0438\u0439\u0433
      \u043E\u043B\u0433\u043E\u0434\u043E\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 32611451731968
    m_Localized: "\u0425\u044D\u043D \u043D\u044D\u0433\u044D\u043D\u0434 \u0442\u0443\u0441\u0430\u043B\u0436,
      \u0448\u0443\u0434\u0430\u0440\u0433\u0430 \u0437\u04AF\u0439\u043B \u0445\u0438\u0439\u0441\u043D\u0438\u0439
      \u0434\u0430\u0440\u0430\u0430 \u0442\u04E9\u0440\u04E9\u0445 \u0431\u0430\u044F\u0440
      \u0445\u04E9\u04E9\u0440. \u04E8\u04E9\u0440\u0438\u0439\u043D \u0445\u0438\u0439\u0441\u044D\u043D
      \u0437\u04E9\u0432 \u04AF\u0439\u043B \u0431\u0443\u0441\u0434\u0430\u0434
      \u0431\u0430\u0433\u0430 \u0447 \u0433\u044D\u0441\u044D\u043D \u0433\u044D\u0440\u043B\u0438\u0439\u0433
      \u0442\u04AF\u0433\u044D\u044D\u0436 \u0447\u0430\u0434\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 32669463150592
    m_Localized: "\u0411\u0443\u0441\u0434\u044B\u0433 \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u044D\u0436,
      \u043C\u0443\u0443\u0445\u0430\u0439 \u04AF\u0433 \u0445\u044D\u043B\u0436
      \u0431\u0443\u0439\u0433 \u0445\u04E9\u043D\u0434\u043B\u04E9\u043D\u0433\u04E9\u04E9\u0441
      \u0445\u0430\u0440\u0430\u0445\u0430\u0434 \u0434\u043E\u0442\u0440\u043E\u043E\u0441
      \u0447\u0438\u043D\u044C \"\u044D\u043D\u044D \u04AF\u0439\u043B\u0434\u044D\u043B
      \u0445\u044D\u0437\u044D\u044D \u0447 \u0437\u04E9\u0432 \u0431\u0438\u0448
      \u0433\u044D\u0441\u044D\u043D \u043C\u044D\u0434\u0440\u044D\u043C\u0436 \u0442\u04E9\u0440\u0434\u04E9\u0433\"
      \u042D\u043D\u044D \u04AF\u0435\u0434 \u0436\u0438\u0433\u0448\u0441\u044D\u043D\u044D\u044D
      \u0431\u0443\u0441\u0434\u0430\u0430\u0441 \u043D\u0443\u0443\u0445 \u0431\u0438\u0448,
      \u0445\u0430\u0440\u0438\u043D \u043C\u044D\u0434\u0440\u044D\u043C\u0436\u044D\u044D
      \u0448\u0443\u0434\u0430\u0440\u0433\u0430 \u0437\u04E9\u0432 \u04AF\u0439\u043B\u0438\u0439\u0433
      \u0434\u044D\u043C\u0436\u0438\u0445\u044D\u0434 \u0430\u0448\u0438\u0433\u043B\u0430\u0430\u0440\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 32988410609664
    m_Localized: "\u04E8\u043D\u0433\u04E9\u043D\u0438\u0439 \u0434\u0430\u0440\u0430\u0430\u043B\u043B\u044B\u0433
      \u0441\u0430\u0439\u043D \u0446\u044D\u044D\u0436\u043B\u044D\u044D\u0440\u044D\u0439.
      \u0422\u044D\u0433\u044D\u044D\u0434 \u0434\u0430\u0440\u0430\u0430\u043B\u043B\u044B\u043D
