  m_TableData:
  - m_Id: 10972233728
    m_Localized: "\u0411\u04B1\u043B \u0441\u0443\u0440\u0435\u0442 \u049B\u043E\u0440\u043B\u0430\u0443\u0434\u044B\u04A3
      (\u0431\u0443\u043B\u043B\u0438\u043D\u0433\u0442\u0456\u04A3) \u049B\u0430\u0439
      \u0442\u04AF\u0440\u0456\u043D \u0431\u0456\u043B\u0434\u0456\u0440\u0435\u0434\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 781189054464
    m_Localized: "\u0414\u0435\u043D\u0435\u043B\u0435\u0439 \u0431\u0430\u0441\u044B\u043D\u0443 "
    m_Metadata:
      m_Items: []
  - m_Id: 1079328571392
    m_Localized: "\u0421\u04E9\u0437\u0431\u0435\u043D \u0431\u0430\u0441\u044B\u043D\u0443 "
    m_Metadata:
      m_Items: []
  - m_Id: 1243585904640
    m_Localized: "\u04D8\u043B\u0435\u0443\u043C\u0435\u0442\u0442\u0456\u043A \u0431\u0430\u0441\u044B\u043D\u0443 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392567582720
    m_Localized: "\u041A\u0438\u0431\u0435\u0440 \u0430\u0440\u049B\u044B\u043B\u044B
      \u0431\u0430\u0441\u044B\u043D\u0443 "
    m_Metadata:
      m_Items: []
  - m_Id: 1486352220160
    m_Localized: "\u0415\u0433\u0435\u0440 \u0441\u0435\u043D \u0441\u044B\u043D\u044B\u043F\u0442\u0430
      \u043E\u0441\u044B\u043D\u0434\u0430\u0439 \u0436\u0430\u0493\u0434\u0430\u0439\u0434\u044B
      \u043A\u04E9\u0440\u0441\u0435\u04A3, \u0431\u0430\u0441\u049B\u0430\u043B\u0430\u0440\u0493\u0430
      \u043D\u0435 \u0430\u0439\u0442\u044B\u043F, \u04AF\u043D\u0434\u0435\u0443
      \u0442\u0430\u0441\u0442\u0430\u0440 \u0435\u0434\u0456\u04A3"
    m_Metadata:
      m_Items: []
  - m_Id: 1676580683776
    m_Localized: "\u0411\u0430\u0440\u043B\u044B\u0493\u044B\u043C\u044B\u0437 \u0431\u0456\u0440
      \u0441\u044B\u043D\u044B\u043F\u0442\u0430 \u043E\u049B\u0438\u043C\u044B\u0437,
      \u0431\u0456\u0440-\u0431\u0456\u0440\u0456\u043C\u0456\u0437\u0434\u0456 \u0431\u04B1\u043B\u0430\u0439
      \u049B\u043E\u0440\u043B\u0430\u0443\u0434\u044B \u0442\u043E\u049B\u0442\u0430\u0442\u0430\u0439\u044B\u049B"
    m_Metadata:
      m_Items: []
  - m_Id: 1819224768512
    m_Localized: "\u041E\u043D\u044B \u043E\u0440\u044B\u043D\u0434\u044B\u049B\u049B\u0430
      \u043E\u0442\u044B\u0440\u0493\u044B\u0437\u0431\u0430\u04A3\u044B\u0437\u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1902741749760
    m_Localized: "\u041C\u0435\u043D\u0435\u043D \u0430\u043B\u044B\u0441 \u0431\u043E\u043B\u0441\u0430
      \u0431\u043E\u043B\u0434\u044B, \u0431\u0430\u0441\u049B\u0430\u0441\u044B
      \u043C\u0430\u04A3\u044B\u0437\u0434\u044B \u0435\u043C\u0435\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 1997507854336
    m_Localized: "\u0416\u0430\u0440\u0430\u0439\u0434\u044B, \u043C\u04D9\u043D
      \u0431\u0435\u0440\u043C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2118538690560
    m_Localized: "\u0415\u0433\u0435\u0440 \u0431\u0456\u0440\u0435\u0443 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0442\u0435
      \u0441\u0435\u043D\u0456 \u043D\u0435\u043C\u0435\u0441\u0435 \u0434\u043E\u0441\u044B\u04A3\u0434\u044B
      \u0436\u0430\u043C\u0430\u043D\u0434\u0430\u043F \u0436\u0430\u0442\u0441\u0430,
      \u0441\u0435\u043D \u043D\u0435 \u0456\u0441\u0442\u0435\u0443\u0456\u04A3
      \u043A\u0435\u0440\u0435\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 2175082102784
    m_Localized: "\u0421\u043A\u0440\u0438\u043D\u0448\u043E\u0442 \u0436\u0430\u0441\u0430\u043F,
      \u04AF\u043B\u043A\u0435\u043D \u0430\u0434\u0430\u043C\u0493\u0430 (\u0430\u0442\u0430-\u0430\u043D\u0430\u0493\u0430,
      \u043C\u04B1\u0493\u0430\u043B\u0456\u043C\u0433\u0435) \u043A\u04E9\u0440\u0441\u0435\u0442\u0456\u043F,
      \u0448\u0430\u0440\u0430 \u049B\u043E\u043B\u0434\u0430\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2293864792064
    m_Localized: "\u041C\u0430\u0493\u0430\u043D \u049B\u0430\u0442\u044B\u0441\u0442\u044B
      \u0431\u043E\u043B\u043C\u0430\u0441\u0430, \u04AF\u043D\u0441\u0456\u0437
      \u049B\u0430\u043B\u0430 \u0431\u0435\u0440\u0435\u043C\u0456\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2405777211392
    m_Localized: "\u0421\u043E\u043B \u043F\u043E\u0441\u0442 \u043F\u0435\u043D
      \u0447\u0430\u0442\u0442\u044B \u0431\u0430\u0441\u049B\u0430\u043B\u0430\u0440\u043C\u0435\u043D
      \u0431\u04E9\u043B\u0456\u0441\u0435\u043C\u0456\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2524861890560
    m_Localized: "\u0416\u0430\u0443\u0430\u043F \u0440\u0435\u0442\u0456\u043D\u0434\u0435
      \u049B\u043E\u043B\u0434\u0430\u0443 \u0431\u0456\u043B\u0434\u0456\u0440\u0435\u0442\u0456\u043D
      \u044D\u043C\u043E\u0434\u0436\u0438 \u0436\u0456\u0431\u0435\u0440\u0435\u043C\u0456\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2628243095552
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0440, \u0435\u0433\u0435\u0440
      \u0430\u0439\u043D\u0430\u043B\u0430\u04A3\u0434\u0430 \u0431\u0456\u0440\u0435\u0443\u0434\u0456\u04A3
      \u0436\u0430\u043B\u0493\u044B\u0437\u0441\u044B\u0440\u0430\u043F, \u049B\u0438\u043D\u0430\u043B\u0493\u0430\u043D\u044B\u043D
      \u043A\u04E9\u0440\u0441\u0435\u04A3\u0434\u0435\u0440 \u043D\u0435\u043C\u0435\u0441\u0435
      \u0441\u0435\u0437\u0441\u0435\u04A3\u0434\u0435\u0440, \u04AF\u043D\u0434\u0435\u043C\u0435\u0439
      \u049B\u0430\u043B\u043C\u0430\u04A3\u0434\u0430\u0440. \u041A\u04E9\u043C\u0435\u043A
      \u049B\u0430\u0436\u0435\u0442 \u0431\u043E\u043B\u0493\u0430\u043D \u0441\u04D9\u0442\u0442\u0435
      \u043C\u0456\u043D\u0434\u0435\u0442\u0442\u0456 \u0442\u04AF\u0440\u0434\u0435
      \u049B\u043E\u043B \u04B1\u0448\u044B\u043D \u0441\u043E\u0437\u0443\u0493\u0430
      \u0442\u044B\u0440\u044B\u0441\u044B\u04A3\u0434\u0430\u0440. \u04D8\u0440
      \u0431\u0430\u043B\u0430 \u04E9\u0437\u0456\u043D \u0435\u0440\u043A\u0456\u043D
      \u04D9\u0440\u0456 \u049B\u0430\u0443\u0456\u043F\u0441\u0456\u0437 \u0441\u0435\u0437\u0456\u043D\u0435\u0442\u0456\u043D
      \u043E\u0440\u0442\u0430\u043D\u044B \u0431\u0456\u0440\u0433\u0435 \u049B\u04B1\u0440\u0430\u0439\u044B\u049B!"
    m_Metadata:
      m_Items: []
  - m_Id: 2736225452032
    m_Localized: "\u0414\u04B1\u0440\u044B\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2874008338432
    m_Localized: "\u0421\u0443\u0440\u0435\u0442\u043A\u0435 \u043C\u04B1\u049B\u0438\u044F\u0442
      \u049B\u0430\u0440\u0430\u043F \u043A\u04E9\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 7492452941824
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0440, \u049B\u04B1\u0440\u0434\u0430\u0441\u0442\u0430\u0440
      \u0430\u0440\u0430\u0441\u044B\u043D\u0434\u0430\u0493\u044B \u049B\u043E\u0440\u043B\u0430\u0443\u0434\u044B
      \u043A\u04E9\u0440\u0433\u0435\u043D \u0441\u04D9\u0442\u0442\u0435 \u0431\u0456\u0437\u0434\u0456\u04A3
      \u044D\u043C\u043E\u0446\u0438\u044F\u043B\u0430\u0440\u044B\u043C\u044B\u0437
      \u0441\u043E\u043B \u04D9\u0440\u0435\u043A\u0435\u0442\u0442\u0456 \u049B\u0430\u043B\u0430\u0439
      \u0441\u0435\u0437\u0456\u043D\u0435\u0442\u0456\u043D\u0456\u043D \u0436\u04D9\u043D\u0435
      \u043E\u0493\u0430\u043D \u049B\u0430\u043B\u0430\u0439 \u0436\u0430\u0443\u0430\u043F
      \u049B\u0430\u0442\u0443\u0493\u0430 \u0431\u043E\u043B\u0430\u0442\u044B\u043D\u044B\u043D
      \u043A\u04E9\u0440\u0435\u0439\u0456\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 7922851446784
    m_Localized: "\u0422\u04AF\u0441\u0442\u0435\u0440\u0434\u0456\u04A3 \u0440\u0435\u0442\u0442\u0456\u043B\u0456\u0433\u0456\u043D
      \u0436\u0430\u049B\u0441\u044B\u043B\u0430\u043F \u0435\u0441\u0442\u0435 \u0441\u0430\u049B\u0442\u0430\u04A3\u0434\u0430\u0440.
      \u0421\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u0441\u043E\u043B
      \u0440\u0435\u0442\u0442\u0456\u043B\u0456\u043A \u0431\u043E\u0439\u044B\u043D\u0448\u0430
      \u0431\u0430\u0441\u044B\u04A3\u0434\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 7988756545536
    m_Localized: "\u0411\u0456\u0440\u0435\u0443\u0434\u0456\u04A3 \u049B\u043E\u0440\u043B\u044B\u049B
      \u043A\u04E9\u0440\u0456\u043F \u0436\u0430\u0442\u049B\u0430\u043D\u044B\u043D
      \u043A\u04E9\u0440\u0433\u0435\u043D\u0434\u0435 \u0430\u0448\u0443\u044B\u043C
      \u043A\u0435\u043B\u0435\u0434\u0456. \u0411\u04B1\u043B \u0430\u0448\u0443
      \u2014 \u0436\u0430\u0439 \u0493\u0430\u043D\u0430 \u0430\u0448\u0443 \u0435\u043C\u0435\u0441,
      \xAB\u04D9\u0434\u0456\u043B\u0435\u0442\u0441\u0456\u0437\u0434\u0456\u043A\u043A\u0435\xBB
      \u0434\u0435\u0433\u0435\u043D \u043D\u0430\u0440\u0430\u0437\u044B\u043B\u044B\u049B\u0442\u044B\u04A3
      \u0431\u0435\u043B\u0433\u0456\u0441\u0456. \u0410\u0448\u0443\u043B\u0430\u043D\u0493\u0430\u043D
      \u043A\u0435\u0437\u0434\u0435 \u0434\u0435 \u0434\u04B1\u0440\u044B\u0441
      \u04D9\u0440\u0435\u043A\u0435\u0442 \u0436\u0430\u0441\u0430\u043F, \u043A\u04E9\u043C\u0435\u043A
      \u0448\u0430\u049B\u044B\u0440\u0430 \u0430\u043B\u0430\u0441\u044B\u04A3."
    m_Metadata:
      m_Items: []
  - m_Id: 32333046415360
    m_Localized: "\u041A\u0456\u043C\u043D\u0456\u04A3 \u0431\u043E\u043B\u0441\u0430
      \u0434\u0430 \u049B\u043E\u0440\u043B\u044B\u049B \u043A\u04E9\u0440\u0456\u043F
      \u0436\u0430\u0442\u049B\u0430\u043D\u044B\u043D \u043A\u04E9\u0440\u0443 \u04E9\u0442\u0435
      \u04E9\u043A\u0456\u043D\u0456\u0448\u0442\u0456. \u0411\u0456\u0440\u0430\u049B
      \u0431\u04B1\u043B \u043C\u04B1\u04A3 \u0431\u0456\u0437\u0433\u0435: \xAB\u041C\u0435\u043D
      \u043C\u04B1\u043D\u0434\u0430\u0439 \u043D\u04D9\u0440\u0441\u0435\u043D\u0456\u04A3
      \u0436\u0430\u0439 \u0493\u0430\u043D\u0430 \u04E9\u0442\u0456\u043F \u043A\u0435\u0442\u043A\u0435\u043D\u0456\u043D
      \u049B\u0430\u043B\u0430\u043C\u0430\u0439\u043C\u044B\u043D\xBB \u0434\u0435\u043F
      \u0435\u0441\u043A\u0435\u0440\u0442\u0435\u0442\u0456\u043D \u0431\u0435\u043B\u0433\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 32422259261440
    m_Localized: "\u041A\u0456\u043C\u0434\u0456 \u0431\u043E\u043B\u0441\u0430 \u0434\u0430
      \u049B\u043E\u0440\u0493\u0430\u0493\u044B\u04A3 \u043A\u0435\u043B\u0433\u0435\u043D\u0434\u0435,
      \xAB\u04E9\u0437\u0456\u043C \u0434\u0435 \u049B\u043E\u0440\u043B\u044B\u049B
      \u043A\u04E9\u0440\u0443\u0456\u043C \u043C\u04AF\u043C\u043A\u0456\u043D\xBB
      \u0434\u0435\u0433\u0435\u043D \u049B\u043E\u0440\u049B\u044B\u043D\u044B\u0448
      \u0441\u0435\u0437\u0456\u043C\u0456 \u0442\u0443\u0430\u0434\u044B. \u0411\u0456\u0440\u0430\u049B
      \u0434\u04B1\u0440\u044B\u0441 \u0430\u0434\u0430\u043C\u043D\u0430\u043D (\u043C\u04B1\u0493\u0430\u043B\u0456\u043C\u043D\u0435\u043D,
      \u04E9\u0437\u0456\u04A3 \u0441\u0435\u043D\u0435\u0442\u0456\u043D \u0435\u0440\u0435\u0441\u0435\u043A
      \u0430\u0434\u0430\u043C\u043D\u0430\u043D) \u043A\u04E9\u043C\u0435\u043A
      \u0441\u04B1\u0440\u0430\u0443 \u2014 \u049B\u043E\u0440\u049B\u044B\u043D\u044B\u0448\u0442\u044B
      \u0436\u0435\u04A3\u0433\u0435\u043D \u0431\u0430\u0442\u044B\u043B\u0434\u044B\u049B."
    m_Metadata:
      m_Items: []
  - m_Id: 32515146317824
    m_Localized: "\u0411\u0456\u0440\u0435\u0443\u0434\u0456\u04A3 \u049B\u043E\u0440\u043B\u044B\u049B
      \u043A\u04E9\u0440\u0456\u043F \u0436\u0430\u0442\u049B\u0430\u043D\u044B\u043D
      \u043A\u04E9\u0440\u0456\u043F: \xAB\u041D\u0435\u0433\u0435 \u0431\u04B1\u043B\u0430\u0439
      \u0431\u043E\u043B\u044B\u043F \u0436\u0430\u0442\u044B\u0440?\xBB \u0434\u0435\u043F
      \u0442\u0430\u04A3\u0493\u0430\u043B\u0443\u044B\u04A3 \u043C\u04AF\u043C\u043A\u0456\u043D.
      \u0422\u0430\u04A3\u0493\u0430\u043B\u0443 \u0441\u0435\u0437\u0456\u043C\u0456
      \u0431\u0456\u0437\u0433\u0435 \u0442\u04AF\u0441\u0456\u043D\u0443\u0433\u0435,
      \u0441\u04B1\u0440\u0430\u049B \u049B\u043E\u044E\u0493\u0430 \u0436\u04D9\u043D\u0435
      \u043D\u0435\u043D\u0456\u04A3 \u0434\u04B1\u0440\u044B\u0441 \u0435\u043A\u0435\u043D\u0456\u043D
      \u0441\u0430\u0440\u0430\u043B\u0430\u0443\u0493\u0430 \u043C\u04AF\u043C\u043A\u0456\u043D\u0434\u0456\u043A
      \u0431\u0435\u0440\u0435\u0434\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 32611451731968
    m_Localized: "\u041A\u0456\u043C\u0433\u0435 \u0431\u043E\u043B\u0441\u0430 \u0434\u0430
      \u043A\u04E9\u043C\u0435\u043A\u0442\u0435\u0441\u0456\u043F, \u04D9\u0434\u0456\u043B
      \u0456\u0441 \u0436\u0430\u0441\u0430\u0493\u0430\u043D\u043D\u0430\u043D \u043A\u0435\u0439\u0456\u043D
      \u043F\u0430\u0439\u0434\u0430 \u0431\u043E\u043B\u0430\u0442\u044B\u043D \u049B\u0443\u0430\u043D\u044B\u0448.
      \u0421\u0435\u043D\u0456\u04A3 \u0436\u0430\u0441\u0430\u0493\u0430\u043D \u0434\u04B1\u0440\u044B\u0441
      \u0456\u0441\u0456\u04A3 \u04E9\u0437\u0433\u0435\u043B\u0435\u0440\u0433\u0435
      \u0430\u0437 \u0434\u0430 \u0431\u043E\u043B\u0441\u0430 \u0436\u0430\u0440\u044B\u049B
      \u0441\u044B\u0439\u043B\u0430\u0439 \u0430\u043B\u0430\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 32669463150592
    m_Localized: "\u04E8\u0437\u0433\u0435\u043B\u0435\u0440\u0434\u0456 \u0431\u0430\u0441\u044B\u043D\u044B\u043F,
      \u0436\u0430\u043C\u0430\u043D \u0441\u04E9\u0437\u0434\u0435\u0440 \u0430\u0439\u0442\u044B\u043F
      \u0436\u0430\u0442\u049B\u0430\u043D\u044B\u043D \u0441\u044B\u0440\u0442\u0442\u0430\u0439
      \u043A\u04E9\u0440\u0433\u0435\u043D\u0434\u0435, \u0456\u0448\u0456\u04A3\u043D\u0435\u043D
      \xAB\u0431\u04B1\u043B \u04D9\u0440\u0435\u043A\u0435\u0442 \u0435\u0448\u049B\u0430\u0448\u0430\u043D
      \u0434\u04B1\u0440\u044B\u0441 \u0435\u043C\u0435\u0441\xBB \u0434\u0435\u0433\u0435\u043D
      \u0441\u0435\u0437\u0456\u043C \u0442\u0443\u0430\u0434\u044B. \u0411\u04B1\u043B
      \u043A\u0435\u0437\u0434\u0435 \u0436\u0438\u0456\u0440\u043A\u0435\u043D\u0456\u0448\u0456\u04A3\u0434\u0456
      \u0436\u0430\u0441\u044B\u0440\u043C\u0430\u0439, \u043A\u0435\u0440\u0456\u0441\u0456\u043D\u0448\u0435,
      \u0431\u04B1\u043B \u0441\u0435\u0437\u0456\u043C\u0456\u04A3\u0434\u0456 \u04D9\u0434\u0456\u043B\u0434\u0456\u043A\u0442\u0456
      \u049B\u043E\u043B\u0434\u0430\u0443\u0493\u0430 \u0436\u04B1\u043C\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 32988410609664
    m_Localized: "\u0422\u04AF\u0441\u0442\u0435\u0440\u0434\u0456\u04A3 \u0440\u0435\u0442\u0442\u0456\u043B\u0456\u0433\u0456\u043D
      \u0436\u0430\u049B\u0441\u044B\u043B\u0430\u043F \u0435\u0441\u0442\u0435 \u0441\u0430\u049B\u0442\u0430\u04A3\u0434\u0430\u0440.
      \u0421\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u0441\u043E\u043B
