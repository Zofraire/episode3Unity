  m_TableData:
  - m_Id: 11014176768
    m_Localized: "\u0410\u043D\u0433\u0438\u0434 \u0431\u0443\u0439 \u0445\u0430\u0440\u0438\u043B\u0446\u0430\u0430\u043D\u044B
      \u044D\u0435\u0440\u044D\u0433 \u0443\u0443\u0440 \u0430\u043C\u044C\u0441\u0433\u0430\u043B\u044B\u0433
      \u0438\u043B\u0442\u0433\u044D\u0445\u04AF\u0439\u0446 \u0442\u0430\u0432\u0430\u043D
      \u04AF\u0433 \u04E9\u0433\u04AF\u04AF\u043B\u0431\u044D\u0440 \u0431\u043E\u043B\u043E\u043D
      \u0433\u0443\u0440\u0432\u0430\u043D \u0437\u0443\u0440\u0433\u0438\u0439\u0433
      \u043E\u043B\u043E\u043E\u0440\u043E\u0439. \u0425\u0430\u0430\u043D\u0430
      \u0447 \u0431\u0430\u0439\u0436 \u043C\u0430\u0433\u0430\u0434\u0433\u04AF\u0439
      \u0442\u0443\u043B \u0441\u0430\u0439\u043D \u0430\u0436\u0438\u0433\u043B\u0430\u0430\u0440\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 636183576576
    m_Localized: "\u0411\u0438\u0434 \u0445\u04AF\u0441\u044D\u044D\u0433\u04AF\u0439
      \u0431\u0430\u0439\u0445\u0430\u0434 \u043D\u044C \u0445\u04AF\u043D\u0438\u0439
      \u0437\u0443\u0440\u0433\u0438\u0439\u0433 \u0434\u0430\u0440\u0434\u0430\u0433\u0433\u04AF\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1084646948864
    m_Localized: "\u0411\u0438\u0434 \u0431\u04AF\u0434\u04AF\u04AF\u043B\u044D\u0433
      \u04AF\u0433 \u0445\u044D\u0440\u044D\u0433\u043B\u044D\u0445\u0433\u04AF\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1425547395072
    m_Localized: "\u0411\u0443\u0441\u0434\u044B\u0433 \u0434\u043E\u0440\u043E\u043C\u0436\u0438\u043B\u0441\u043E\u043D
      \u04AF\u0433 \u0445\u044D\u043B\u044D\u0445\u0433\u04AF\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1782960816128
    m_Localized: "\u0411\u0438 \u0443\u0443\u0440\u0442\u0430\u0439, \u0442\u04AF\u0440\u044D\u043C\u0433\u0438\u0439
      \u0437\u0430\u043D \u0433\u0430\u0440\u0433\u0430\u0445\u0433\u04AF\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1891211608064
    m_Localized: "\u0411\u0438\u0434 \u0430\u043D\u0433\u0438\u0434\u0430\u0430 \u043D\u044D\u0433\u043D\u044D\u044D
      \u0448\u043E\u043E\u043B\u0434\u043E\u0433\u0433\u04AF\u0439.."
    m_Metadata:
      m_Items: []
  - m_Id: 1981137485824
    m_Localized: "\u0411\u0438 \u0431\u0443\u0441\u0434\u044B\u0433 \u0445\u04AF\u043D\u0434\u044D\u043B\u0436
      \u0445\u0430\u0440\u0438\u043B\u0446\u0430\u0445 \u0431\u043E\u043B\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2185559474176
    m_Localized: "\u0411\u0438\u0434 \u0431\u0443\u0441\u0434\u044B\u043D \u044D\u0434
      \u0437\u04AF\u0439\u043B\u0434 \u0434\u0443\u0440\u0430\u0430\u0440\u0430\u0430
      \u0445\u04AF\u0440\u044D\u0445\u0438\u0439\u0433 \u04AF\u0440\u0433\u044D\u043B\u0436
      \u044D\u0441\u044D\u0440\u0433\u04AF\u04AF\u0446\u043D\u044D."
    m_Metadata:
      m_Items: []
  - m_Id: 2304858062848
    m_Localized: "\u041D\u044D\u0433\u044D\u043D\u0434\u044D\u044D \u0445\u04AF\u043D\u0434\u044D\u0442\u0433\u044D\u043B\u0442\u044D\u0439
      \u0445\u0430\u043D\u0434\u0430\u0445\u044B\u0433 \u0443\u0440\u0438\u0430\u043B\u0436
      \u0431\u0430\u0439\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2467320233984
    m_Localized: "\u0421\u0442\u0438\u043A\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2610421497856
    m_Localized: "\u0422\u04AF\u043B\u0445\u04AF\u04AF\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2721365032960
    m_Localized: "\u0417\u0443\u0440\u0430\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 2817653669888
    m_Localized: "\u0424\u0443\u0442\u0431\u043E\u043B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2977196605440
    m_Localized: "\u041D\u043E\u043C\u043D\u0443\u0443\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 3108977442816
    m_Localized: "\u042D\u043D\u0433\u044D\u0440\u0438\u0439\u043D \u0442\u044D\u043C\u0434\u044D\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 3306805985280
    m_Localized: "\u0428\u0430\u043B\u0433\u0430\u043B\u0442\u044B\u043D \u0446\u0430\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 3497437102080
    m_Localized: "\u0422\u044D\u043C\u0434\u044D\u0433\u043B\u044D\u043B\u0438\u0439\u043D
      \u0446\u0430\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 6117639782400
    m_Localized: "\u042D\u0434 \u0437\u04AF\u0439\u043B\u0441\u0438\u0439\u0433 \u044D\u0437\u044D\u043D\u0434
      \u043D\u044C \u0442\u0430\u0430\u0440\u0443\u0443\u043B\u0436 \u04E9\u0433\u04E9\u04E9\u0440\u044D\u0439. "
    m_Metadata:
      m_Items: []
  - m_Id: 6248560787456
    m_Localized: "\u0411\u0438 \u04AF\u0435 \u0442\u044D\u043D\u0433\u0438\u0439\u043D
      \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u044D\u043B\u0442\u044D\u0434 \u04E9\u0440\u0442\u04E9\u0436
      \u0431\u0443\u0439 \u043D\u044D\u0433\u043D\u0438\u0439 \u0434\u0443\u0443
      \u0445\u043E\u043E\u043B\u043E\u0439\u0433 \u0441\u043E\u043D\u0441\u043E\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6365149855744
    m_Localized: "\u0411\u0438 \u04AF\u0435 \u0442\u044D\u043D\u0433\u0438\u0439\u043D
      \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u044D\u043B\u0442\u0442\u044D\u0439
      \u0442\u0430\u0430\u0440\u0432\u0430\u043B, \u0445\u0430\u0440\u0430\u0430\u0433\u04AF\u0439
      \u044E\u043C \u0448\u0438\u0433 \u04E9\u043D\u0433\u04E9\u0440\u04E9\u0445\u0433\u04AF\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6423182245888
    m_Localized: "\u0411\u0438 \u04AF\u0435 \u0442\u044D\u043D\u0433\u0438\u0439\u043D
      \u0434\u044D\u044D\u0440\u044D\u043B\u0445\u044D\u043B\u0442\u0438\u0439\u0433
      \u043C\u044D\u0434\u0441\u044D\u043D \u0431\u043E\u043B \u0445\u044D\u043D
      \u043D\u044D\u0433\u044D\u043D \u0438\u0442\u0433\u044D\u0436 \u0431\u043E\u043B\u043E\u0445
      \u0442\u043E\u043C \u0445\u04AF\u043D\u0434 \u0437\u0430\u0430\u0432\u0430\u043B
      \u0445\u044D\u043B\u043D\u044D. "
    m_Metadata:
      m_Items: []
  - m_Id: 6478765162496
    m_Localized: "\u0411\u0438\u0441 \u04AF\u0435 \u0447\u0435\u0440\u0433\u0435\u043D\u0438\u04A3
      \u0431\u0430\u0441\u0442\u044B\u044B\u0440 \u0447\u043E\u0440\u0443\u0443\u043D
      \u201C\u0414\u044B\u04A3\u043D\u0430\u0430\u0440 \u0431\u0438\u0441, \u041A\u04E9\u04E9\u0440
      \u0431\u0438\u0441, \u0410\u0430\u0439\u0442\u044B\u044B\u0440 \u0431\u0438\u0441\u201D
      \u0442\u043E\u0433\u0431\u0430\u0439\u043D \u04E9\u0442\u043A\u04AF\u0440\u0431\u0435\u0441
      \u0431\u0438\u0441. \u0411\u043E\u0434\u0443\u0432\u0443\u0441\u0442\u0443\u04A3
      \u0448\u044B\u0434\u0430\u0430\u0440\u044B\u0432\u044B\u0441\u0442\u0430\u043D
      \u043A\u0438\u0440\u0436\u0438\u043F, \u043A\u0430\u0434\u044B \u0434\u043E\u043A\u0442\u0430\u0430\u0434\u044B\u043F
      \u0448\u044B\u0434\u0430\u0430\u0440 \u0431\u0438\u0441. "
    m_Metadata:
      m_Items: []
  - m_Id: 6586588135424
    m_Localized: "\u0410\u0441\u0443\u0443\u043B\u0442\u0430\u043D\u0434 \u0437\u04E9\u0432
      \u0445\u0430\u0440\u0438\u0443\u043B\u0436 \u201C\u0422\u0443\u0441\u043B\u0430\u043C\u0436\u0438\u0439\u043D
      \u0433\u04AF\u04AF\u0440\u0438\u0439\u0433\u201D \u044F\u043D\u0437\u043B\u0430\u043D
      \u043E\u0445\u0438\u043D\u0434 \u0442\u0443\u0441\u0430\u043B\u0446\u0433\u0430\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6664744796160
    m_Localized: "\u041D\u0430\u0439\u0437 \u0447\u0438\u043D\u044C \u0443\u0439\u043B\u0436
      \u0431\u0430\u0439\u043D\u0430, \u0447\u0438 \u044F\u0430\u0445 \u0432\u044D?"
    m_Metadata:
      m_Items: []
  - m_Id: 6783376490496
    m_Localized: "\u0417\u04AF\u0433\u044D\u044D\u0440 \u0434\u044D\u044D, \u0442\u0430\u0439\u0432\u0448\u0438\u0440
      \u0433\u044D\u044D\u0434 \u043E\u0440\u0445\u0438\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6891564367872
    m_Localized: "\u042F\u0430\u0433\u0430\u0430\u0434 \u0443\u0439\u043B\u0441\u0430\u043D
      \u0448\u0430\u043B\u0442\u0433\u0430\u0430\u043D\u044B\u0433 \u0430\u0441\u0443\u0443\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6994765217792
    m_Localized: "\"\u041D\u0430\u0439\u0437\u044B\u043D \u0447\u0438\u043D\u044C
      \u044D\u0434 \u0437\u04AF\u0439\u043B\u0441\u0438\u0439\u0433 \u0441\u0430\u043D\u0430\u0430\u0442\u0430\u0439\u0433\u0430\u0430\u0440
      \u0443\u0440\u0436, \u0430\u043D\u0433\u0438\u0439\u043D \u0431\u0443\u043B\u0430\u043D\u0434\n\u0448\u0438\u0434\u0441\u044D\u043D
      \u0442\u0443\u0445\u0430\u0439 \u0441\u043E\u043D\u0441\u0432\u043E\u043B\u201D
      \u0447\u0438 \u044F\u0430\u0445 \u0432\u044D?\""
    m_Metadata:
      m_Items: []
  - m_Id: 7082099015680
    m_Localized: "\u0410. \u0411\u0430\u0433\u0448\u0438\u0434 \u0445\u044D\u043B\u044D\u0445\u0438\u0439\u0433
      \u0437\u04E9\u0432\u043B\u04E9\u043D\u04E9 "
    m_Metadata:
      m_Items: []
  - m_Id: 7148297715712
    m_Localized: "\"\u0411. \u0417\u0430 \u0434\u0430\u0440\u0430\u0430\u0433\u0438\u0439\u043D
      \u0443\u0434\u0430\u0430 \u0442\u044D\u0433\u044D\u0445\u0433\u04AF\u0439 \u0431\u0430\u0439\u0445\u0430\u0430
      \u044D\u043D\u044D \u0443\u0434\u0430\u0430\n\u0437\u04AF\u0433\u044D\u044D\u0440
      \u043E\u0440\u0445\u0438\u0447\u0438\u0445 \u0433\u044D\u0436 \u0437\u04E9\u0432\u043B\u04E9\u043D\u04E9\""
    m_Metadata:
      m_Items: []
  - m_Id: 7227104493568
    m_Localized: "\"\u041D\u0430\u0439\u0437\u044B\u043D \u0447\u0438\u043D\u044C
      \u0433\u0430\u0440 \u0445\u04E9\u0445\u04E9\u0440\u0441\u04E9\u043D \u0431\u0430\u0439\u0445
      \u0431\u0430 \u0442\u04AF\u04AF\u043D\u0438\u0439\u0433\u044D\u044D \u0438\u043B\u0442\u044D\u0434
      \u0447\u0430\u043C\u0430\u0430\u0441 \u043D\u0443\u0443\u043D\u0430.\n\u042D\u043D\u044D
      \u04AF\u0435\u0434 \u0447\u0438 \u044F\u0430\u0445 \u0432\u044D? \""
    m_Metadata:
      m_Items: []
  - m_Id: 7286416146432
    m_Localized: "\u0410. \u041D\u0443\u0443\u0433\u0430\u0430\u0434 \u0431\u0430\u0439\u0433\u0430\u0430
      \u044E\u043C \u0447\u0438\u043D\u044C \u0431\u0438 \u044F\u0430\u0445\u0430\u0432
      \u0434\u044D\u044D \u0433\u044D\u044D\u0434 \u043E\u0440\u0445\u0438\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 7363742334976
    m_Localized: "\u0411. \u0427\u04AF\u0433\u0435 \u043A\u04E9\u0433\u0435\u0440\u0433\u0435\u043D\u0438\u043D
      \u0442\u043E\u0434\u0430\u0440\u0430\u0434\u044B\u043F \u0441\u0443\u0440\u0430\u0430\u0448,
      \u0431\u0430\u0448\u043A\u044B\u043D\u0430\u043D \u0447\u04E9\u0432\u04AF\u043B\u0435\u0436\u0438\u0438\u0440
      \u043C\u0435\u043D. "
    m_Metadata:
      m_Items: []
  - m_Id: 7940559798272
    m_Localized: "\u0422\u0443\u0441\u043B\u0430\u043C\u0436\u0438\u0439\u043D \u0433\u04AF\u04AF\u0440\u0438\u0439\u0433
      \u044F\u043D\u0437\u0430\u043B\u0436 \u04E9\u0433\u0441\u04E9\u043D\u0434 \u0431\u0430\u044F\u0440\u043B\u0430\u043B\u0430\u0430."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
